      - name: Validate scripts and Wind Frontier rules
        shell: bash
        run: |
          set -euo pipefail
          python3 test/overworld/ValidateWFCrystals.py
          python3 test/overworld/ValidateWindFrontierStarters.py
          python3 test/overworld/ValidateWindFrontierCoop.py
          python3 test/overworld/ValidateGen13.py
          python3 test/overworld/ValidateConfigRules.py
          python3 test/overworld/ValidateScripts.py
      - name: Build GBA ROM
        shell: bash
        run: |
          set -euo pipefail
          touch .histignore
          make modern -j2
          echo "ROM files after compilation:"
          find . -type f -iname '*.gba' -print
          mkdir -p /tmp/wf-rom
          find . -type f -iname '*.gba' -exec cp -v {} /tmp/wf-rom/ \;
          if ! find /tmp/wf-rom -maxdepth 1 -type f -iname '*.gba' | grep -q .; then
            echo 'ERROR: Build finished without a .gba ROM. Check make output and project build target.' >&2
            exit 1
          fi
      - name: Publish ROM for testing
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: wind-frontier-alpha-0-3-2-crystals
          path: /tmp/wf-rom/*.gba
          if-no-files-found: error
